---
import Layout from '../layouts/Layout.astro';
import Header from '../../../shared/src/components/Header.astro';
import Footer from '../../../shared/src/components/Footer.astro';
import Hero from '../components/Hero.astro';
import MethodExplainer from '../components/MethodExplainer.astro';
import WhyQQKids from '../components/WhyQQKids.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SmartKidsBooks from '../components/SmartKidsBooks.astro';
import Testimonials from '../components/Testimonials.astro';
import LeadForm from '../components/LeadForm.astro';
import FAQ from '../components/FAQ.astro';
import Partners from '../components/Partners.astro';

const title = "Curso de Inglês para Crianças Online | QQEnglish Kids";
const description = "Curso de inglês para crianças online com professores especializados. Aulas individuais lúdicas para crianças de 3 a 12 anos. Agende uma aula grátis.";
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <MethodExplainer />
    <WhyQQKids />
    <HowItWorks />
    <SmartKidsBooks />
    <Testimonials />
    <LeadForm />
    <FAQ />
    <Partners />
  </main>
  <Footer />
</Layout>
