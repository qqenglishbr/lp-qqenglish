---
// Shared components
import Layout from '../layouts/Layout.astro';
import Header from '../../../shared/src/components/Header.astro';
import Footer from '../../../shared/src/components/Footer.astro';
import TrainingTeachers from '../../../shared/src/components/TrainingTeachers.astro';

// LP-specific components
import Hero from '../components/Hero.astro';
import SpeedComparison from '../components/SpeedComparison.astro';
import Benefits from '../components/Benefits.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PromoHighlight from '../components/PromoHighlight.astro';
import Testimonials from '../components/Testimonials.astro';
import LeadForm from '../components/LeadForm.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';

const title = "Curso de Inglês Rápido | Aulas Diárias Online | QQEnglish";
const description = "Aprenda inglês mais rápido com aulas diárias de 25 min. Até 30 aulas/mês por R$140. Professores certificados, 24h por dia. Agende sua aula grátis.";
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <SpeedComparison />
    <Benefits />
    <HowItWorks />
    <TrainingTeachers />
    <PromoHighlight />
    <Testimonials />
    <LeadForm />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>

<style>
  main {
    padding-top: 64px; /* Space for fixed header */
  }
</style>
