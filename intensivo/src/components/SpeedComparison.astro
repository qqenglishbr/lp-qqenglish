---
// SpeedComparison - Comparativo visual QQEnglish vs Escola Tradicional
// Seção diferencial desta LP focada em velocidade de aprendizado
const rows = [
  { label: "Aulas por mês", traditional: "4 a 8", qq: "Até 30", icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>` },
  { label: "Formato", traditional: "Turma (5-15 alunos)", qq: "1:1 individual", icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>` },
  { label: "Duração da aula", traditional: "60-90 min", qq: "25 min focados", icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>` },
  { label: "Horários", traditional: "Fixos e limitados", qq: "24/7 flexível", icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>` },
  { label: "Tempo para resultados", traditional: "Anos", qq: "Meses", icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` },
];
---

<section class="comparison-section" id="comparativo">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge">Comparativo</span>
      <h2>Por que aprender inglês aqui é mais rápido</h2>
      <p>Veja a diferença entre uma escola tradicional e a QQEnglish</p>
    </div>

    <div class="comparison-table reveal">
      <!-- Table Header -->
      <div class="table-header">
        <div class="header-cell label-cell"></div>
        <div class="header-cell traditional-cell">
          <span class="header-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </span>
          <span>Escola Tradicional</span>
        </div>
        <div class="header-cell qq-cell">
          <span class="header-icon qq-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </span>
          <span>QQEnglish</span>
        </div>
      </div>

      <!-- Table Rows -->
      {rows.map((row) => (
        <div class="table-row">
          <div class="row-cell label-cell">
            <span class="row-icon" set:html={row.icon} />
            <span class="row-label">{row.label}</span>
          </div>
          <div class="row-cell traditional-cell">
            <span class="traditional-value">{row.traditional}</span>
          </div>
          <div class="row-cell qq-cell">
            <span class="qq-value">
              <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              {row.qq}
            </span>
          </div>
        </div>
      ))}
    </div>

    <div class="comparison-cta reveal">
      <a href="#lead-form" class="btn-lp">
        Quero Aprender Mais Rápido
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding: var(--section-padding) 0;
    background: white;
  }

  .section-header { text-align: center; max-width: 640px; margin: 0 auto 3rem; }
  .section-badge { display: inline-block; padding: 0.375rem 1rem; font-size: 0.8125rem; font-weight: 600; color: var(--color-primary); background: var(--color-primary-subtle); border-radius: var(--radius-full); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .section-header h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 0.75rem; }
  .section-header p { font-size: 1.125rem; color: var(--color-gray-600); }

  .comparison-table {
    max-width: 900px;
    margin: 0 auto 3rem;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-gray-200);
  }

  .table-header {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    background: var(--color-gray-50);
    border-bottom: 2px solid var(--color-gray-200);
  }

  .header-cell {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .header-cell.traditional-cell {
    color: var(--color-gray-500);
    justify-content: center;
    text-align: center;
  }

  .header-cell.qq-cell {
    background: linear-gradient(135deg, var(--color-primary) 0%, #0e7490 100%);
    color: white;
    justify-content: center;
    text-align: center;
  }

  .header-icon { display: flex; align-items: center; }
  .header-icon.qq-icon { color: white; }

  .table-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    border-bottom: 1px solid var(--color-gray-100);
    transition: background var(--transition-fast);
  }

  .table-row:last-child { border-bottom: none; }
  .table-row:hover { background: var(--color-gray-50); }

  .row-cell {
    padding: 1.125rem 1.5rem;
    display: flex;
    align-items: center;
    font-size: 0.9375rem;
  }

  .row-cell.label-cell {
    gap: 0.75rem;
    color: var(--color-dark);
    font-weight: 500;
  }

  .row-icon {
    flex-shrink: 0;
    color: var(--color-gray-400);
    display: flex;
    align-items: center;
  }

  .row-cell.traditional-cell {
    justify-content: center;
    text-align: center;
  }

  .traditional-value {
    color: var(--color-gray-500);
    font-size: 0.875rem;
  }

  .row-cell.qq-cell {
    justify-content: center;
    text-align: center;
    background: rgba(8, 145, 178, 0.04);
  }

  .qq-value {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-primary-dark);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .check-icon { color: var(--color-success); flex-shrink: 0; }

  .comparison-cta { text-align: center; }

  /* Mobile: Stack layout */
  @media (max-width: 768px) {
    .table-header { grid-template-columns: 1fr 1fr; }
    .header-cell.label-cell { display: none; }

    .table-row {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 1rem 1.25rem;
    }

    .row-cell { padding: 0.5rem 0; }

    .row-cell.label-cell {
      font-weight: 600;
      font-size: 0.875rem;
      color: var(--color-gray-600);
      border-bottom: none;
    }

    .row-cell.traditional-cell,
    .row-cell.qq-cell {
      justify-content: flex-start;
      text-align: left;
      padding-left: 2.25rem;
    }

    .row-cell.traditional-cell::before {
      content: 'Tradicional: ';
      font-size: 0.75rem;
      color: var(--color-gray-400);
      font-weight: 600;
      text-transform: uppercase;
    }

    .row-cell.qq-cell::before {
      content: 'QQEnglish: ';
      font-size: 0.75rem;
      color: var(--color-primary);
      font-weight: 600;
      text-transform: uppercase;
    }

    .row-cell.qq-cell { background: transparent; }
  }

  .reveal { opacity: 0; transform: translateY(20px); transition: all 0.6s ease; }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
</style>
