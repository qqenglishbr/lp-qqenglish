---
// Benefits - 6 benefícios focados em velocidade de aprendizado
const benefits = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"/></svg>`,
    title: "Prática diária",
    description: "Até 30 aulas/mês para criar o hábito diário. Frequência é o segredo para aprender rápido."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>`,
    title: "Aulas 1:1",
    description: "Todo o tempo da aula é SEU. Sem dividir atenção com uma turma de 10 alunos."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: "25 minutos focados",
    description: "Sessões curtas e intensas, sem enrolação. Cabe no seu almoço ou antes do trabalho."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: "Disponível 24/7",
    description: "Estude de manhã, à tarde ou de madrugada. Sempre tem professor disponível."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 10 3 12 0v-5"/></svg>`,
    title: "Professores TESOL",
    description: "1.300+ professores com certificação internacional e 550+ horas de treinamento."
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
    title: "Sem contrato",
    description: "Cancele quando quiser, sem multa. Zero risco para experimentar."
  }
];
---

<section class="benefits-section" id="beneficios">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge">Aprendizado acelerado</span>
      <h2>Por que você vai aprender inglês mais rápido aqui</h2>
      <p>Tudo pensado para quem quer resultados em menos tempo</p>
    </div>

    <div class="benefits-grid">
      {benefits.map((benefit, index) => (
        <div class="benefit-card reveal" style={`animation-delay: ${index * 0.1}s`}>
          <div class="benefit-icon" set:html={benefit.icon} />
          <h3>{benefit.title}</h3>
          <p>{benefit.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits-section { padding: var(--section-padding) 0; background: linear-gradient(180deg, var(--color-gray-50) 0%, white 100%); }

  .section-header { text-align: center; max-width: 640px; margin: 0 auto 3.5rem; }
  .section-badge { display: inline-block; padding: 0.375rem 1rem; font-size: 0.8125rem; font-weight: 600; color: var(--color-primary); background: var(--color-primary-subtle); border-radius: var(--radius-full); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .section-header h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); color: var(--color-dark); margin-bottom: 0.75rem; }
  .section-header p { font-size: 1.125rem; color: var(--color-gray-600); }

  .benefits-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 640px) { .benefits-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .benefits-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }

  .benefit-card { background: white; padding: 2rem 1.75rem; border-radius: var(--radius-lg); transition: all var(--transition-base); border: 1px solid transparent; }
  .benefit-card:hover { border-color: var(--color-gray-200); box-shadow: var(--shadow-lg); transform: translateY(-4px); }

  .benefit-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: var(--color-primary-subtle); color: var(--color-primary); border-radius: var(--radius-md); margin-bottom: 1.25rem; transition: all var(--transition-base); }
  .benefit-card:hover .benefit-icon { background: var(--color-primary); color: white; }

  .benefit-card h3 { font-size: 1.125rem; font-weight: 600; color: var(--color-dark); margin-bottom: 0.5rem; }
  .benefit-card p { font-size: 0.9375rem; color: var(--color-gray-600); line-height: 1.6; }

  .reveal { opacity: 0; transform: translateY(20px); transition: all 0.6s ease; }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
</style>
